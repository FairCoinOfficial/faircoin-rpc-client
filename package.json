{
  "name": "@fairco.in/rpc-client",
  "version": "0.1.0",
  "description": "JSON-RPC client for the FairCoin daemon (faircoind). Zero-dependency, pure TypeScript, Node 20+.",
  "author": "FairCoin <dev@fairco.in>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairCoinOfficial/faircoin-rpc-client.git"
  },
  "bugs": {
    "url": "https://github.com/FairCoinOfficial/faircoin-rpc-client/issues"
  },
  "homepage": "https://github.com/FairCoinOfficial/faircoin-rpc-client#readme",
  "keywords": [
    "faircoin",
    "cryptocurrency",
    "bitcoin-rpc",
    "json-rpc",
    "typescript"
  ]
}
